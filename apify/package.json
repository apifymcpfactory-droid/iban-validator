{
    "name": "iban-validator",
    "version": "0.0.1",
    "type": "module",
    "description": "Validates IBANs offline via the ISO 13616 mod-97 checksum and per-country BBAN structure — no external API, no licensed data.",
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "apify": "^3.7.0"
    },
    "devDependencies": {
        "@types/node": "^22.15.21",
        "typescript": "^5.8.3",
        "tsx": "^4.19.4",
        "vitest": "^3.0.0"
    },
    "scripts": {
        "start": "npm run start:dev",
        "start:prod": "node dist/main.js",
        "start:dev": "tsx src/main.ts",
        "build": "tsc",
        "test": "vitest run"
    },
    "author": "Howth Technology Factory",
    "license": "ISC"
}
